<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Details Form</title>
</head>
<body>
    <h1>Update Your Details</h1>
    <form action="/doupdate" method="post">
        <label>Name</label>
        <input type="text" placeholder="title" name="title">
        <input type="text" placeholder="first" name="first">
        <input type="text" placeholder="last"  name="last">
        </br><label>Login</label>
        <input type="email" placeholder="me@example.com"    name="email">
        <input type="text" placeholder="username"     name="username">
        <input type="password" placeholder="password"  name="password">
        </br><label>Details</label>
        <input type="text" placeholder="gender" name="gender">
        <input type="datetime" placeholder="date of birth"    name="dob">
        <input type="text" placeholder="nationality" name="nat">
        </br><label>Location</label>
        <input type="text" placeholder="street"   name="street">
        <input type="text" placeholder="city"     name="city">
        <input type="text" placeholder="state"    name="state">
        <input type="text" placeholder="postcode" name="postcode">
        </br><label>Pictures</label>
          <input type="text" placeholder="large"     name="large">
          <input type="text" placeholder="medium"    name="medium">
          <input type="text" placeholder="thumbnail" name="thumbnail">
        </br><button type="submit">Submit</button>
    </form>
</body>
</html></html>