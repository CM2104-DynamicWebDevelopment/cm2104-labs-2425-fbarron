<html>
  <head>
    <title>Socket.IO chat</title>
    <link rel="stylesheet" href="styles/main.css" />
  </head>
  <body>
    <ul id="messages"></ul>
    <form id="chat-form" action="">
      <input id="username" placeholder="Enter your username" autocomplete="off" />
      <select id="room">
        <option value="general">General</option>
        <option value="tech">Tech</option>
        <option value="sports">Sports</option>
      </select>
      <input id="input" placeholder="Type your message here" autocomplete="off" />
      <button id="send">Send</button>
    </form>

    <form id="register-form" action="">
      <input id="username" placeholder="Enter your username" autocomplete="off" />
      <button id="register">Register</button>
    </form>
    
    <form id="private-message-form" action="">
      <input id="recipient" placeholder="Recipient's username" autocomplete="off" />
      <input id="private-message-input" placeholder="Type your message" autocomplete="off" />
      <button id="send-private">Send Private</button>
    </form>
    
    <ul id="messages"></ul>
    
    
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="scripts/main.js"></script>
  </body>
</html>
